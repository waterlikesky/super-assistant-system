# sas 读取 SAS_* 环境变量（不会自动加载 .env 文件）：在 shell 里 export，或用 direnv 等工具加载；
# 也可以把同名小写键写进 ./sas.toml，例如 me = ["水如天"]。
# 永远不要把真实密钥或聊天导出提交进仓库。

SAS_DB_PATH=data/sas.db
# 导出里代表「我」的昵称 / 邮箱，逗号分隔
SAS_ME=我
SAS_ME_EMAILS=
SAS_TZ=Asia/Shanghai

# LLM：none（默认，纯离线）| ollama（本机 http://127.0.0.1:11434）| llm（simonw/llm）
SAS_LLM_BACKEND=none
SAS_LLM_MODEL=
SAS_OLLAMA_URL=http://127.0.0.1:11434
# 云端模型（含 mem0 默认配置、云 embedding）必须显式打开；打开后也只发送脱敏片段
SAS_ALLOW_CLOUD_LLM=false

# 出站（自动回复/代发）没有实现；设为 true 会直接报错
SAS_OUTBOUND_ENABLED=false

# 记忆后端：local（默认）| mem0（额外镜像一份到 mem0，需 pip install '.[mem0]'）
SAS_MEMORY_BACKEND=local
# 语义检索（可选，需 pip install '.[llm,vec]'）
SAS_EMBED_MODEL=
