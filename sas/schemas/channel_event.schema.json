{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/waterlikesky/super-assistant-system/sas/schemas/channel_event.schema.json",
  "title": "ChannelEvent",
  "description": "所有渠道归一后的单条消息。入库前已脱敏。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "channel",
    "direction",
    "timestamp",
    "content_text",
    "sensitivity",
    "consent_tag"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "稳定 id：同一条消息重复摄入得到同一个 id" },
    "channel": {
      "type": "string",
      "enum": ["email", "wechat", "dingtalk", "sms", "feishu", "file", "other"]
    },
    "direction": { "type": "string", "enum": ["inbound", "outbound"], "description": "outbound = 我发出的（只用于理解语境，系统不发送）" },
    "timestamp": { "type": "string", "format": "date-time" },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "handle"],
        "properties": {
          "role": { "type": "string", "enum": ["from", "to", "cc", "self", "other"] },
          "handle": { "type": "string", "description": "已打码或哈希的标识" },
          "display_name": { "type": "string" }
        }
      }
    },
    "thread_id": { "type": ["string", "null"] },
    "conversation": { "type": ["string", "null"], "description": "会话名：私聊对象 / 群名 / 邮件主题；已脱敏" },
    "content_text": { "type": "string" },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "personal", "confidential"]
    },
    "consent_tag": { "type": "string", "minLength": 1 },
    "raw_ref": {
      "type": ["string", "null"],
      "description": "仅本机路径；不复制、不上传原文"
    },
    "metadata": { "type": "object" }
  }
}
